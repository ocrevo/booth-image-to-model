{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:booth-image-to-model:spec:2.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "image",
        "sha256",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "scale": {
      "type": "object",
      "properties": {
        "units": {
          "const": "m"
        },
        "basis": {
          "enum": [
            "user_dimensions",
            "user_assumption",
            "single_image_estimate"
          ]
        },
        "footprint_m": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1e-09
          },
          "minItems": 2,
          "maxItems": 2
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "units",
        "basis",
        "footprint_m",
        "notes"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "enum": [
                  "booth",
                  "venue",
                  "neighbor",
                  "unknown"
                ]
              },
              "decision": {
                "enum": [
                  "include",
                  "exclude",
                  "defer"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "owner",
              "decision",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "decisions"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "const": "booth"
          },
          "kind": {
            "enum": [
              "box",
              "cylinder",
              "rounded_ring",
              "rounded_portal",
              "swept_strip",
              "profile_extrusion",
              "arc_panel",
              "text"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "critical": {
            "type": "boolean"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "observed",
                  "inferred"
                ]
              },
              "roi_xyxy_norm": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 4,
                "maxItems": 4
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "note"
            ],
            "allOf": [
              {
                "if": {"properties": {"status": {"const": "observed"}}, "required": ["status"]},
                "then": {"required": ["roi_xyxy_norm"]}
              }
            ],
            "additionalProperties": false
          },
          "location": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "rotation_deg": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "params": {
            "type": "object"
          },
          "material": {
            "type": "object",
            "properties": {
              "color_space": {
                "enum": ["linear", "srgb"],
                "default": "linear"
              },
              "color": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 4,
                "maxItems": 4
              },
              "roughness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "metallic": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "emission": {
                "type": "number",
                "minimum": 0
              },
              "pattern": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {"type": {"const": "projected"}},
                    "required": ["type"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {"const": "grid"},
                      "spacing": {
                        "type": "array",
                        "items": {"type": "number", "exclusiveMinimum": 0},
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "line_width": {"type": "number", "exclusiveMinimum": 0},
                      "line_color": {
                        "type": "array",
                        "items": {"type": "number", "minimum": 0, "maximum": 1},
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "coordinates": {"enum": ["auto", "xy", "xz", "yz", "arc_length_z"]},
                      "offset": {
                        "type": "array",
                        "items": {"type": "number"},
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "arc_origin_deg": {"type": "number"}
                    },
                    "required": ["type", "spacing", "line_width", "line_color"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {"const": "dots"},
                      "spacing": {
                        "type": "array",
                        "items": {"type": "number", "exclusiveMinimum": 0},
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "radius_m": {"type": "number", "exclusiveMinimum": 0},
                      "dot_color": {
                        "type": "array",
                        "items": {"type": "number", "minimum": 0, "maximum": 1},
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "coordinates": {"enum": ["auto", "xy", "xz", "yz", "arc_length_z", "box"]},
                      "offset": {
                        "type": "array",
                        "items": {"type": "number"},
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "arc_origin_deg": {"type": "number"},
                      "fade": {
                        "oneOf": [
                          {"type": "null"},
                          {
                            "type": "object",
                            "properties": {
                              "axis": {"enum": ["x", "y", "z"]},
                              "from_m": {"type": "number"},
                              "to_m": {"type": "number"}
                            },
                            "required": ["axis", "from_m", "to_m"],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": ["type", "spacing", "radius_m", "dot_color"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {"const": "grain"},
                      "scale_m": {"type": "number", "exclusiveMinimum": 0},
                      "strength": {"type": "number", "minimum": 0, "maximum": 1},
                      "grain_color": {
                        "type": "array",
                        "items": {"type": "number", "minimum": 0, "maximum": 1},
                        "minItems": 3,
                        "maxItems": 3
                      }
                    },
                    "required": ["type", "scale_m", "strength", "grain_color"],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "color"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "scope_id",
          "owner",
          "kind",
          "role",
          "critical",
          "evidence",
          "location",
          "rotation_deg",
          "params",
          "material"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "box"
                }
              }
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "size": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 1e-09
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "bevel_radius": {
                      "type": "number",
                      "minimum": 0
                    },
                    "bevel_mode": {
                      "enum": ["all", "vertical"],
                      "default": "all"
                    },
                    "segments_per_corner": {
                      "type": "integer",
                      "minimum": 4,
                      "maximum": 128
                    }
                  },
                  "required": [
                    "size"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "cylinder"
                }
              }
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "radius": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "segments": {
                      "type": "integer",
                      "minimum": 12,
                      "maximum": 512
                    }
                  },
                  "required": [
                    "radius",
                    "height"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "rounded_ring"
                }
              }
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "outer_size": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 1e-09
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "inner_size": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 1e-09
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "outer_radius": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "inner_radius": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "segments_per_corner": {
                      "type": "integer",
                      "minimum": 4,
                      "maximum": 128
                    }
                  },
                  "required": [
                    "outer_size",
                    "inner_size",
                    "outer_radius",
                    "inner_radius",
                    "height"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "rounded_portal"
                }
              }
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "height": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "depth": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "side_width": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "beam_height": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "outer_radius": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "inner_radius": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "segments_per_corner": {
                      "type": "integer",
                      "minimum": 4,
                      "maximum": 128
                    }
                  },
                  "required": [
                    "width",
                    "height",
                    "depth",
                    "side_width",
                    "beam_height",
                    "outer_radius",
                    "inner_radius"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "swept_strip"
                }
              }
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "control_points": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {"type": "number"},
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "minItems": 4
                    },
                    "width": {"type": "number", "exclusiveMinimum": 0},
                    "depth": {"type": "number", "exclusiveMinimum": 0},
                    "segments_per_curve": {"type": "integer", "minimum": 4, "maximum": 128}
                  },
                  "required": ["control_points", "width", "depth"],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {"properties": {"kind": {"const": "profile_extrusion"}}},
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {"type": "number"},
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "minItems": 3,
                      "maxItems": 1024
                    },
                    "depth": {"type": "number", "exclusiveMinimum": 0}
                  },
                  "required": ["profile", "depth"],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {"properties": {"kind": {"const": "arc_panel"}}},
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "radius": {"type": "number", "exclusiveMinimum": 0},
                    "thickness": {"type": "number", "exclusiveMinimum": 0},
                    "height": {"type": "number", "exclusiveMinimum": 0},
                    "start_deg": {"type": "number"},
                    "end_deg": {"type": "number"},
                    "segments": {"type": "integer", "minimum": 4, "maximum": 512}
                  },
                  "required": ["radius", "thickness", "height", "start_deg", "end_deg"],
                  "additionalProperties": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "text"
                }
              }
            },
            "then": {
              "properties": {
                "params": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "type": "string",
                      "minLength": 1
                    },
                    "size": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "extrude": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "body",
                    "size"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "camera": {
      "type": "object",
      "properties": {
        "projection": {
          "enum": [
            "perspective",
            "orthographic"
          ]
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "target": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "lens_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sensor_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ortho_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "principal_point": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pixel_aspect": {
          "const": [
            1,
            1
          ]
        },
        "fit_status": {
          "enum": [
            "unfitted",
            "landmark_fitted",
            "reviewed"
          ]
        },
        "roll_deg": {
          "type": "number"
        }
      },
      "required": [
        "projection",
        "position",
        "target",
        "principal_point",
        "pixel_aspect",
        "fit_status"
      ],
      "allOf": [
        {
          "if": {"properties": {"projection": {"const": "perspective"}}, "required": ["projection"]},
          "then": {"required": ["lens_mm", "sensor_width_mm"]}
        },
        {
          "if": {"properties": {"projection": {"const": "orthographic"}}, "required": ["projection"]},
          "then": {"required": ["ortho_scale"]}
        }
      ],
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "box",
              "cylinder",
              "rounded_ring",
              "rounded_portal",
              "swept_strip",
              "profile_extrusion",
              "arc_panel",
              "text"
            ]
          },
          "must_be_critical": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "component_id"
        ],
        "additionalProperties": false
      }
    },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "component_id": {
            "type": "string",
            "minLength": 1
          },
          "local_xyz": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "uv": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "visibility": {
            "enum": [
              "visible",
              "occluded"
            ]
          },
          "fit": {
            "type": "boolean"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "component_id",
          "local_xyz",
          "uv",
          "visibility",
          "fit"
        ],
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "critical": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "resolved_by_evidence",
              "accepted_by_user"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "critical",
          "status",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "silhouette_iou_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "part_iou_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "landmark_median_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "landmark_p90_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "boundary_distance_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "threshold_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "silhouette_iou_min",
        "part_iou_min",
        "landmark_median_max",
        "landmark_p90_max",
        "boundary_distance_max",
        "threshold_basis"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project",
    "source",
    "scale",
    "scope",
    "components",
    "camera",
    "requirements",
    "landmarks",
    "uncertainties",
    "quality"
  ],
  "additionalProperties": false
}
