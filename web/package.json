{
  "name": "booth-image-to-model-web",
  "version": "2.10.0-rc1",
  "private": true,
  "type": "module",
  "description": "Web studio (local server, one window from picture to render) and standalone spec editor for booth-image-to-model. The deployable static site is app/; server/, tests/ and tools/ are not served.",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/ocrevo/booth-image-to-model.git", "directory": "web" },
  "engines": { "node": ">=22.15" },
  "scripts": {
    "start": "node tools/py.mjs server/run.py",
    "serve": "node tools/py.mjs tools/serve.py",
    "test": "node --import ./tests/register-three.mjs --test",
    "test:server": "node tools/py.mjs -m unittest discover -s tests -p \"test_*.py\"",
    "smoke": "node tests/smoke.mjs",
    "smoke:studio": "node tests/studio_smoke.mjs"
  }
}
